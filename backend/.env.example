# Copy to .env and adjust. .env is gitignored; keep the password there only.

APP_NAME=AI Attendance Marker
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# MySQL. The password has no default in application code.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_attendance

# Required for POST /auth/login. Generate a value and keep it only in .env:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
