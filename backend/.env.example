# Copy to .env and adjust. .env is gitignored; keep the password there only.

APP_NAME=AI Attendance Marker
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# MySQL. The password has no default in application code.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_attendance

# Required for POST /auth/login. Generate a value and keep it only in .env:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Face recognition. Distance is Euclidean; a face matches at or below this value.
# 0.6 is the usual face_recognition tolerance. Lower is stricter.
FACE_MATCH_THRESHOLD=0.6
# Seconds to keep enrolled embeddings in memory. Enrollment clears this cache.
# 0 reloads on the next recognition call.
FACE_EMBEDDING_CACHE_SECONDS=60

# Attendance date and late check-in. Use an IANA name, such as Asia/Kolkata.
ATTENDANCE_TIMEZONE=UTC
# Local HH:MM. A face check-in at or after this time is LATE. Empty means PRESENT.
ATTENDANCE_LATE_AFTER=
