# Copy to .env in the repository root before `docker compose up`.
# Compose reads this file for substitution. Do not commit .env.

APP_NAME=AI Attendance Marker
APP_ENV=production
DEBUG=false
APP_PORT=8000

# MYSQL_USER=root uses MYSQL_PASSWORD as the database root password.
# For a separate account, set MYSQL_USER to that name and set MYSQL_ROOT_PASSWORD too.
MYSQL_USER=root
MYSQL_PASSWORD=change-me-app-password
MYSQL_DATABASE=ai_attendance
# MYSQL_ROOT_PASSWORD=

# At least 32 bytes. Replace this before anyone else can reach the server:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-generate-a-real-secret-with-secrets-token-urlsafe
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FACE_MATCH_THRESHOLD=0.6
FACE_EMBEDDING_CACHE_SECONDS=60

# Calendar date for attendance. Example: Asia/Kolkata
ATTENDANCE_TIMEZONE=UTC
# Local HH:MM. Empty records PRESENT. A check-in at or after this time is LATE.
ATTENDANCE_LATE_AFTER=
